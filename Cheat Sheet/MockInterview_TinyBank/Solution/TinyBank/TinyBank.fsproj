<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <!--
    F# compiles files from top to bottom, so this list is also the architecture.
    Each file may use only the files above it:

      Domain            the vocabulary: types only, depends on nothing
      Parse             text -> domain values
      AccountDirectory  loads the accounts and looks them up
      Ledger            the banking rules (pure functions)
      Forecast          savings projection (pure functions)
      Bank              the one stateful object; wraps Ledger
      Reporting         turns results into text
      Program           the entry point; must be last

    WHY THIS ORDER: dependencies point one way, from the outside (files, console)
    towards the inside (rules and types). The rules cannot accidentally depend
    on the console, because Reporting and Program come after them.
  -->
  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Parse.fs" />
    <Compile Include="AccountDirectory.fs" />
    <Compile Include="Ledger.fs" />
    <Compile Include="Forecast.fs" />
    <Compile Include="Bank.fs" />
    <Compile Include="Reporting.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
